{
  "name": "mothdraw",
  "version": "0.1.0",
  "description": "Procedural moth line drawings: a seed goes in, a pinned-specimen drawing comes out.",
  "type": "module",
  "license": "MIT",
  "author": "Abdellah Darni",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --minify --format=esm --outfile=dist/mothdraw.min.js",
    "bench": "npm run build --silent && node --expose-gc bench/bench.js",
    "test": "node --test test/*.test.js",
    "serve": "node tools/serve.js",
    "sheet": "node tools/contact-sheet.js",
    "similar": "node tools/similar.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
