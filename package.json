{
  "name": "mothdraw",
  "version": "0.1.0",
  "description": "Procedural moth line drawings: a seed goes in, a pinned-specimen drawing comes out.",
  "type": "module",
  "license": "MIT",
  "author": "Abdellah Darni",
  "exports": {
    ".": "./src/index.js",
    "./mount": "./src/mount.js"
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild mothdraw=src/index.js worker=src/worker.js --bundle --minify --format=esm --outdir=dist",
    "bench": "node --expose-gc bench/bench.js",
    "perf": "node tools/perf-generate.js && node tools/perf-mount.js",
    "test": "node --test test/*.test.js",
    "serve": "node tools/serve.js",
    "sheet": "node tools/contact-sheet.js",
    "similar": "node tools/similar.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
