{
  "name": "mothdraw",
  "version": "0.1.0",
  "description": "Procedural moth drawings in the style of a naturalist's plate: a seed goes in, a line drawing of a moth comes out. Includes a continuous mode that draws moth after moth.",
  "keywords": [
    "generative",
    "procedural",
    "moth",
    "drawing",
    "plotter",
    "canvas",
    "svg"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Abdellah Darni",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./mount": {
      "types": "./types/mount.d.ts",
      "default": "./src/mount.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild mothdraw=src/index.js worker=src/worker.js --bundle --minify --format=esm --splitting --chunk-names=chunks/[name]-[hash] --target=es2020,chrome100,firefox114,safari15 --outdir=dist",
    "bench": "node --expose-gc bench/bench.js",
    "perf": "node tools/perf-generate.js && node tools/perf-mount.js",
    "test": "node --test test/*.test.js",
    "serve": "node tools/serve.js",
    "sheet": "node tools/contact-sheet.js",
    "similar": "node tools/similar.js",
    "types": "npx -y -p typescript@5 tsc -p tsconfig.types.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
